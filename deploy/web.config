<?xml version="1.0" encoding="utf-8"?>
<!--
  Đặt file này vào thư mục gốc của site IIS, ngang hàng với index.html:
      D:\IIS WEB\be-shopminhnhat.click\web.config

  Site này phục vụ hai thứ cùng lúc:
    - Dashboard (file tĩnh trong dist\ của frontend) — IIS tự phục vụ
    - API và Socket.IO — chuyển tiếp xuống Node đang chạy ở 127.0.0.1:4000

  Cùng một tên miền nên trình duyệt gọi đường tương đối /api, không có CORS,
  không cần VITE_PROXY_TARGET, không cần build lại khi đổi tên miền.
-->
<configuration>
  <system.webServer>

    <!--
      Nghe ngược đời nhưng bắt buộc phải là false.

      Tính năng WebSocket của Windows vẫn phải được CÀI (Install-WindowsFeature
      Web-WebSockets), còn ở đây phải TẮT — để IIS không tự trả lời gói nâng cấp
      WebSocket mà nhường cho ARR chuyển tiếp nguyên vẹn xuống Node.
      Để true thì Socket.IO bắt tay hỏng: trang vẫn mở được nhưng số liệu đứng
      im, phải F5 mới thấy — và trông y hệt lỗi frontend.

      Nếu IIS báo lỗi 500.19 "section is locked at a parent level" ở dòng này,
      mở khoá bằng:
        appcmd.exe unlock config -section:system.webServer/webSocket
    -->
    <webSocket enabled="false" />

    <rewrite>
      <rules>

        <!--
          THỨ TỰ QUAN TRỌNG: luật proxy phải đứng TRƯỚC luật SPA bên dưới.
          Luật SPA bắt mọi đường dẫn, nên nếu đảo ngược thì /api cũng bị nuốt và
          trả về index.html thay vì gọi tới Node.
        -->
        <rule name="Proxy API va Socket.IO" stopProcessing="true">
          <match url="^(api|socket\.io)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:4000/{R:1}{R:2}" />
        </rule>

        <!--
          Router của React chạy phía trình duyệt. Vào thẳng /control hay
          /settings thì trên đĩa không có file nào tên như vậy — phải trả về
          index.html để React tự định tuyến.
          Thiếu luật này thì bấm trong trang vẫn chạy, nhưng F5 ở trang con ra
          404 — kiểu lỗi chỉ lộ ra khi demo.

          Hai điều kiện bên dưới giữ cho file và thư mục CÓ THẬT vẫn được phục
          vụ bình thường, nên assets\ không bị nuốt.
        -->
        <rule name="SPA fallback">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

    <!--
      Vite gắn mã băm vào tên file (index-Deajo603.js). Đổi code là đổi tên file,
      nên bản cũ không bao giờ bị dùng nhầm — cache thoải mái một năm.
      index.html thì KHÔNG cache: nó là chỗ duy nhất trỏ tới tên file mới.
    -->
    <location path="assets">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
        </staticContent>
      </system.webServer>
    </location>

    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!--
      DetailedLocalOnly: lỗi đầy đủ khi mở từ chính server, còn người ngoài chỉ
      thấy thông báo chung. Để "Detailed" là lộ đường dẫn thật của server ra
      Internet — chỉ bật tạm khi đang dò lỗi, xong nhớ trả lại.
    -->
    <httpErrors errorMode="DetailedLocalOnly" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
