<?xml version="1.0" encoding="utf-8"?>
<!--
  Đặt file này vào thư mục gốc của site IIS, ngang hàng với index.html:
      D:\IIS WEB\be-shopminhnhat.click\web.config

  Site phục vụ hai thứ cùng lúc:
    - Dashboard: file tĩnh (index.html + assets\) — IIS tự phục vụ
    - API và Socket.IO: chuyển tiếp xuống Node đang chạy ở 127.0.0.1:4000

  Cùng một tên miền nên trình duyệt gọi đường tương đối /api — không CORS,
  không cần VITE_PROXY_TARGET, không phải build lại khi đổi tên miền.
-->
<configuration>
  <system.webServer>

    <!--
      Nghe ngược đời nhưng bắt buộc phải là false.

      Tính năng WebSocket của Windows vẫn phải được CÀI (Install-WindowsFeature
      Web-WebSockets), còn ở đây phải TẮT — để IIS không tự trả lời gói nâng cấp
      WebSocket mà nhường cho ARR chuyển tiếp nguyên vẹn xuống Node.
      Để true thì Socket.IO bắt tay hỏng: trang vẫn mở nhưng số liệu đứng im.

      Nếu IIS báo 500.19 "section is locked at a parent level" ở dòng này:
        appcmd.exe unlock config -section:system.webServer/webSocket
    -->
    <webSocket enabled="false" />

    <rewrite>
      <rules>

        <!--
          THỨ TỰ QUAN TRỌNG: luật proxy phải đứng TRƯỚC luật SPA bên dưới.
          Luật SPA bắt mọi đường dẫn, nên đảo ngược là /api cũng bị nuốt và trả
          về index.html thay vì đi tới Node.
        -->
        <rule name="Proxy API va Socket.IO" stopProcessing="true">
          <match url="^(api|socket\.io)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:4000/{R:1}{R:2}" />
        </rule>

        <!--
          Router của React chạy phía trình duyệt. Vào thẳng /control hay
          /settings thì trên đĩa không có file nào tên vậy — phải trả index.html
          để React tự định tuyến. Thiếu luật này thì bấm trong trang vẫn chạy
          nhưng F5 ở trang con ra 404.

          Hai điều kiện negate giữ cho file và thư mục CÓ THẬT vẫn được phục vụ,
          nên assets\ không bị nuốt.
        -->
        <rule name="SPA fallback">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>

<!--
  ============================================================================
  PHẦN TÙY CHỌN — chỉ thêm khi phần trên đã chạy được
  ============================================================================

  Vite gắn mã băm vào tên file (index-Deajo603.js), đổi code là đổi tên file,
  nên assets cache thoải mái. Riêng index.html thì cấm cache vì nó là chỗ duy
  nhất trỏ tới tên file mới.

  LƯU Ý: <location> phải là con TRỰC TIẾP của <configuration>, KHÔNG được nằm
  trong <system.webServer>. Đặt sai chỗ là 500 ngay.

  Chép hai khối dưới đây vào NGAY TRƯỚC thẻ </configuration>:

    <location path="assets">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
        </staticContent>
      </system.webServer>
    </location>

  Và thêm vào trong <system.webServer> ở trên:

    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

  Nếu sau khi thêm mà lại 500 thì mục staticContent đang bị khoá ở cấp máy chủ:
    appcmd.exe unlock config -section:system.webServer/staticContent
-->
