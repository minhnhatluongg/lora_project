# Copy to .env and adjust as needed
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Shared secret. ESP32 must send it in the "x-api-key" header on write endpoints.
# Leave empty to disable auth (development only).
DEVICE_API_KEY=changeme-esp32-secret

# Secret used to sign user login JWTs. Change in production.
JWT_SECRET=changeme-jwt-secret
JWT_EXPIRES_IN=12h

# Default admin account created on first run (change after first login!)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# SQLite database file (relative to backend/)
DB_FILE=./data/farm.db

# Default alert thresholds, as MIN/MAX pairs. These seed the config on FIRST run
# only — after that, edit them on the SETTINGS screen, which writes to the DB.
PH_MIN=5.5
PH_MAX=7.5
# EC in µS/cm — the raw value the RS485 probe reports (1000 µS/cm = 1 mS/cm).
# The HMI shows mS/cm; the conversion happens in the frontend, never in the DB.
EC_MIN=0
EC_MAX=2500
# Soil temperature (°C). Above TEMP_MAX is the only threshold that raises 'danger'.
TEMP_MIN=15
TEMP_MAX=40
# Soil humidity (%)
HUMIDITY_MIN=30
HUMIDITY_MAX=90
# NPK minimums in mg/kg (probe registers 5..7)
N_MIN=50
P_MIN=30
K_MIN=60
# Warn when an ultrasonic tank drops below this fill level (%)
TANK_LOW_PCT=20

# --- Chu kỳ tưới (phút) ------------------------------------------------------
# Chống bơm đóng/ngắt liên tục khi cảm biến dao động quanh ngưỡng: bơm vừa được
# AUTO bật phải chạy đủ RUN phút mới được tắt, tắt rồi phải nghỉ đủ REST phút mới
# được bật lại. Chỉ áp dụng cho bơm và chỉ chặn luật tự động, không chặn lệnh tay.
IRRIGATION_RUN_MINUTES=15
IRRIGATION_REST_MINUTES=45

# If the master hasn't posted telemetry within this many seconds, it's marked OFFLINE
MASTER_TIMEOUT_SECONDS=30

# Don't repeat an identical threshold alert more often than this (seconds)
ALERT_REPEAT_SECONDS=600

# --- Độ tin cậy hàng đợi lệnh ------------------------------------------------
# Lệnh đã gửi cho ESP32 mà không được xác nhận trong ngần này giây -> phát lại
COMMAND_RETRY_SECONDS=30
# Phát lại quá số lần này -> đánh dấu 'failed', không lặp vô hạn
COMMAND_MAX_ATTEMPTS=3
# Lệnh nằm chờ quá lâu (ESP32 offline) -> hủy, tránh phát lại ý định đã cũ
COMMAND_TTL_SECONDS=300
COMMAND_HISTORY_DAYS=7

# --- Dọn dẹp dữ liệu (0 = giữ mãi mãi) ---------------------------------------
# Mỗi node ghi ~35.000 dòng/ngày, không dọn thì file DB phình không giới hạn
TELEMETRY_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=30
