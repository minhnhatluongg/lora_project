# Copy to .env and adjust as needed
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Shared secret. ESP32 must send it in the "x-api-key" header on write endpoints.
# Leave empty to disable auth (development only).
DEVICE_API_KEY=changeme-esp32-secret

# Secret used to sign user login JWTs. Change in production.
JWT_SECRET=changeme-jwt-secret
JWT_EXPIRES_IN=12h

# Default admin account created on first run (change after first login!)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# SQLite database file (relative to backend/)
DB_FILE=./data/farm.db

# Default alert thresholds. These seed the config on FIRST run only — after that,
# edit them in the web UI (Cài đặt & Tự động), which writes to the database.
PH_MIN=5.5
PH_MAX=7.5
# EC in µS/cm — the raw value the RS485 probe reports (1000 µS/cm = 1 mS/cm)
EC_MAX=2500
TEMP_MAX=40
HUMIDITY_MIN=30
# NPK minimums in mg/kg (probe registers 5..7)
N_MIN=50
P_MIN=30
K_MIN=60
# Warn when an ultrasonic tank drops below this fill level (%)
TANK_LOW_PCT=20

# If the master hasn't posted telemetry within this many seconds, it's marked OFFLINE
MASTER_TIMEOUT_SECONDS=30

# Don't repeat an identical threshold alert more often than this (seconds)
ALERT_REPEAT_SECONDS=600
