# Chép thành .env.local khi backend KHÔNG chạy trên máy này.
#
# Trình duyệt chỉ nói chuyện với dev server (localhost:5173); Vite chuyển tiếp
# /api và /socket.io sang địa chỉ dưới đây. Nhờ vậy không phải thêm CORS trên
# server, không phải dựng lại bundle, và đổi server chỉ là sửa một dòng này.
#
# Bỏ trống / không có file này = backend chạy ngay trên máy này (cổng 4000).
VITE_PROXY_TARGET=http://iot.tenmiencuaban.com
